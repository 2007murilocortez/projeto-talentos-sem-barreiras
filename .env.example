# Copie este arquivo para .env.local e preencha os valores.
# O .env.local é ignorado pelo git — nunca commite chaves.
#
# ATENÇÃO: no Vite, só variáveis com prefixo VITE_ chegam ao navegador.
# Tudo que estiver aqui vira código público no bundle. Portanto, aqui só entra
# o que pode ser lido por qualquer pessoa que abrir o DevTools.
# A service role key do Supabase NUNCA entra no front-end, em hipótese alguma.

# Qual implementação de repositório a aplicação usa.
# in-memory = dados fake em memória, roda sem backend (padrão até a Fase 8)
# supabase  = backend real
VITE_DATA_SOURCE=in-memory

# Supabase — necessários apenas quando VITE_DATA_SOURCE=supabase.
# Encontre em: Supabase > Project Settings > API
# A anon key é pública por design; quem protege os dados é a RLS, não o segredo da chave.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Nome do ambiente exibido em telas internas (local | preview | production)
VITE_APP_ENV=local
